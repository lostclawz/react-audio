{
  "name": "react-audio",
  "version": "0.0.1",
  "description": "web audio api react components",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lostclawz/react-audio.git"
  },
  "author": "Philip Kuperberg",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lostclawz/react-audio/issues"
  },
  "homepage": "https://github.com/lostclawz/react-audio#readme",
  "dependencies": {
    "classnames": "^2.2.6",
    "prop-types": "^15.7.2",
    "ramda": "^0.32.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "^~/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "testMatch": [
      "**/src/**/*test*.{js,jsx}",
      "**/tests/**/*.{js,jsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/utils/testing-utils.js"
    ]
  }
}
